# Copy this file to ".env" and fill in real values. ".env" is gitignored.

# --- Gemini AI (Phase 7) ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# --- Database (optional override) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalyx_db

# --- Auth / JWT (optional overrides) ---
# JWT_SECRET_KEY=dev-secret-key-change-me
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
